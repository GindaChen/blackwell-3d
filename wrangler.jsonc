// Cloudflare Workers static-assets deployment for the Vite build in ./dist.
// Deploy: `npm run deploy` (after a one-time `npx wrangler login`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vera-rubin-3d",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
